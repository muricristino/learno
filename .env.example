# Copy this to `.env` at the repo root. The repo is the workspace.

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=my_study_learn          # change per study
PORT=9990

# Lessons derive the API base from the page's own origin, so any port works and
# the workspace stays reachable through a tunnel (`make start`) — the hardcoded
# localhost is only a fallback for pages opened via file://.

# ── Optional ─────────────────────────────────────────────────────────────────
# LEARNO_WORKSPACE — absolute path to the workspace to serve. Defaults to the
#   repo root, which is what you want. It exists for one caller: the engine's own
#   sandbox (`make sandbox`), which serves fixtures instead of your real content.
#
# LEARNO_MODE=sandbox — engine development only. Replaces MongoDB with an
#   in-memory store and the Gemini call with a deterministic stub, so neither
#   MONGODB_URI nor GEMINI_API_KEY is needed. See sandbox/README.md.
