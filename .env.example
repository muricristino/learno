# Copy to `.env` at the repo root.

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=9990
# LEARNO_DB=learno.db   # progress store, relative to the workspace root by default

# Optional, engine development only:
# LEARNO_WORKSPACE — workspace to serve; defaults to the repo root. Used by `make sandbox`.
# LEARNO_MODE=sandbox — seeded in-memory store and stubbed Gemini; no key needed.
